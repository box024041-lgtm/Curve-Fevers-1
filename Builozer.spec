[app]
title = Curve Game
package.name = curvegame
package.domain = org.game
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,wav,mp3,ogg,ttf
version = 0.1
requirements = python3,pygame
orientation = portrait
fullscreen = 1
android.archs = arm64-v8a, armeabi-v7a

[buildozer]
log_level = 2
warn_on_root = 1
